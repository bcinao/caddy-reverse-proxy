# global options
{
	admin off # theres no need for the admin api in railway's environment
	persist_config off # storage isn't persistent anyway
	auto_https off # railway handles https for us, this could in some cases cause issues if left enabled
	# runtime logs
	log {
		format json # set runtime log format to json mode 
	}
	# server options
	servers {
		trusted_proxies static private_ranges # trust railway's proxy
	}
}

(lb_settings) {
	lb_policy round_robin
	lb_retries 1
	lb_try_duration 10s
	lb_try_interval 250ms
}

(passive_health_checks) {
	fail_duration 60s
	max_fails 300
	unhealthy_latency 5s
	unhealthy_request_count 200
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT} {
    log {
        format json
    }

    # 1. API PROXY (Backend)
    # Ensure $BACKEND_PATH is set to /api in Railway env vars
    handle_path {$BACKEND_PATH:/api} {
        reverse_proxy {
            dynamic a {
                name {$BACKEND_DOMAIN}
                port {$BACKEND_PORT}
                refresh 1s
            }
            import lb_settings
            import passive_health_checks

			header_up Host {upstream_hostport} # Keep this for Railway routing
            
            # Add these for your Rust API's awareness
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}

        }
    }

    # 2. SVELTEKIT (Frontend)
    # Using 'handle' without a path makes this the fallback/catch-all
    handle {
        reverse_proxy {
            dynamic a {
                name {$FRONTEND_DOMAIN}
                port {$FRONTEND_PORT}
                refresh 1s
            }
            import lb_settings
            import passive_health_checks

			 # 1. Keep internal routing host
            header_up Host {upstream_hostport} 

            # 2. Pass the "Public" identity to SvelteKit
            header_up X-Forwarded-Host {host}
            
            # 3. CRITICAL: SvelteKit uses this to see "https" instead of "http"
            header_up X-Forwarded-Proto {header.X-Forwarded-Proto}
            
            # 4. Pass the real user IP
            header_up X-Real-IP {header.Cf-Connecting-Ip}

        }
    }
}
